# Copy to .env.local and fill in. Never commit real values.

# --- Mode 1: Web App -> Claude -> MCP -> n8n (preferred) ---
ANTHROPIC_API_KEY=
# n8n instance-level MCP server URL and access token (n8n: Settings -> MCP / Instance-level MCP)
N8N_MCP_URL=
N8N_MCP_TOKEN=
# Optional: ID of "LeadPilot — Qualify Lead" so Claude skips the search step
N8N_WORKFLOW_ID=

# --- Mode 2: Web App -> n8n webhook directly ---
N8N_LEADPILOT_WEBHOOK_URL=

# Nothing set -> clearly-labelled Demo Mode.
